+/**
+ * Resolve the agy binary.
+ *
+ * LOCAL PATCH (not upstream). `spawn("agy")` resolves through PATH, but the
+ * Antigravity installer registers its directory on the *User* PATH only, which a
+ * process started before the install — or one whose parent inherited just the
+ * Machine PATH — never sees. agy then reports `agy_unavailable (exit 127)` even
+ * though the binary is present and working.
+ *
+ * PATH is still tried first, so an on-PATH install behaves exactly as before.
+ * The fallback is consulted only when a plain spawn would fail. Delete this
+ * function and revert the two call sites to restore stock behaviour.
+ */
+function agyBinary() {
+  try {
+    execFileSync("agy", ["--version"], { stdio: "ignore", timeout: 10_000 });
+    return "agy";
+  } catch (err) {
+    // Only a genuinely missing binary falls through to the candidates; a binary
+    // that exists but errors must keep its real error.
+    if (err && err.code !== "ENOENT") return "agy";
+  }
+  const home = process.env.USERPROFILE || process.env.HOME || "";
+  const localAppData = process.env.LOCALAPPDATA || "";
+  const candidates = [
+    localAppData && join(localAppData, "agy", "bin", process.platform === "win32" ? "agy.exe" : "agy"),
+    home && join(home, ".antigravity", "bin", process.platform === "win32" ? "agy.exe" : "agy"),
+    home && join(home, ".local", "bin", "agy"),
+  ].filter(Boolean);
+  for (const candidate of candidates) {
+    try {
+      if (statSync(candidate).isFile()) return candidate;
+    } catch {
+      // keep looking
+    }
+  }
+  return "agy";
+}
