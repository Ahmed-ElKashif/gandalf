+/**
+ * The posture agy actually ran under.
+ *
+ * The result used to report the REQUESTED flags: `opts.sandbox` and
+ * `opts.dangerouslySkipPermissions`. A read-only run adds
+ * `--sandbox --dangerously-skip-permissions` on its own (see buildArgv), so for
+ * every read-only lane the result said "sandbox: false, auto-approve: false"
+ * while agy ran with both. A reader — a landing report, a reviewer, another
+ * relay — could not tell what the run was allowed to do.
+ *
+ * LOCAL PATCH (not upstream). Delete this function and the two result fields to
+ * restore stock behaviour.
+ */
+function effectivePosture(opts) {
+  const sandbox = Boolean(opts.readOnly || opts.sandbox);
+  const dangerouslySkipPermissions = Boolean(opts.readOnly || opts.dangerouslySkipPermissions);
+  // Measured: agy 1.4.4 on Windows does not enforce --sandbox; the macOS build
+  // does. So the flags are worth reporting next to the platform they ran on.
+  const enforced = sandbox && process.platform !== "win32";
+  return {
+    sandbox,
+    dangerouslySkipPermissions,
+    readOnly: Boolean(opts.readOnly),
+    flags: [
+      ...(sandbox ? ["--sandbox"] : []),
+      ...(dangerouslySkipPermissions ? ["--dangerously-skip-permissions"] : []),
+    ],
+    platform: process.platform,
+    enforced,
+    caveat: enforced
+      ? null
+      : sandbox
+        ? "--sandbox is not enforced on Windows (measured on agy 1.4.4): a read-only run is a request, not a guarantee"
+        : null,
+  };
+}
+
 function timestamp() {
   return new Date().toISOString().replace(/[:.]/g, "-");
 }
@@ -494,6 +542,10 @@ function buildArgv(opts, brief, run) {
   // parser intercepts a value that is exactly a bare flag (a brief consisting only of
   // "--help" or "-h" prints usage instead of running). The = form always binds the value.
   argv.push(`--print=${brief}`);
+  // Record what agy is actually given, so result.json carries the ground truth
+  // and not only a derivation of it. The brief is elided: it can be 120KB, and
+  // result.json is read by people.
+  run.argv = argv.map((arg) => (arg.startsWith("--print=") ? "--print=<brief>" : arg));
   return argv;
 }
 
